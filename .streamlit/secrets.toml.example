# Streamlit Secrets Template for Lab Prestasi RAG MVP
# PENTING: Jangan masukkan kredensial asli di sini. Salin berkas ini ke secrets.toml.

# Kredensial Akun Bersama Chatbot
[auth]
username = "labprestasi"
# Hash password (gunakan scripts/make_password_hash.py untuk menghasilkan hash aman)
password_hash = "$2b$12$e8xL8lYx..."

# Kredensial Groq API (openai/gpt-oss-20b)
[groq]
api_key = "gsk_..."

# Kredensial Google Service Account (untuk sinkronisasi Drive dan Sheets di lingkungan produksi)
# Pada lingkungan pengembangan lokal / dummy, repositori lokal digunakan tanpa memerlukan kredensial ini.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-sa@your-project-id.iam.gserviceaccount.com"
client_id = "123456789"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"

[drive]
# ID folder Google Drive tempat ChromaDB zip dan manifest disimpan
folder_id = "your_google_drive_folder_id"
