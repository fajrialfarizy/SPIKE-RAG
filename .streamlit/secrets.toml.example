# Template Streamlit Secrets — Lab Prestasi RAG
#
# Salin berkas ini menjadi .streamlit/secrets.toml (JANGAN di-commit) atau isi
# lewat Streamlit Cloud → Settings → Secrets. Semua nilai di bawah placeholder.

# Akun bersama chatbot.
[auth]
username = "labprestasi"
# Buat dengan: python scripts/make_password_hash.py
# Format: pbkdf2_sha256$<iterations>$<salt>$<digest>
password_hash = "pbkdf2_sha256$600000$REPLACE_WITH_SALT$REPLACE_WITH_DIGEST"

# Kunci Groq API (openai/gpt-oss-20b). Jangan pernah ditampilkan di layar/log.
[groq]
api_key = "gsk_REPLACE_ME"

# Sumber knowledge base.
#   source = "local"  -> memakai chroma_db yang sudah ada (pengembangan lokal)
#   source = "drive"  -> unduh manifest + zip dari folder Drive privat
[kb]
source = "local"
local_dir = "chroma_db"
# Manifest yang ditulis scripts/run_ingestion.py (mode local).
manifest_path = "data/artifacts/manifest.json"
drive_folder_id = "REPLACE_WITH_DRIVE_FOLDER_ID"
drive_manifest_name = "manifest.json"
drive_artifact_name = "chroma_backup.zip"
work_dir = "data/kb_work"
# Interval minimal pemeriksaan ulang manifest (detik).
manifest_ttl_seconds = 300

# Service account Google Drive (scope read-only). Hanya dipakai bila source = "drive".
[gcp_service_account]
type = "service_account"
project_id = "REPLACE_WITH_PROJECT_ID"
private_key_id = "REPLACE_WITH_KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_KEY\n-----END PRIVATE KEY-----\n"
client_email = "lab-prestasi-reader@REPLACE_WITH_PROJECT_ID.iam.gserviceaccount.com"
client_id = "REPLACE_WITH_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/REPLACE_WITH_SA_EMAIL"
